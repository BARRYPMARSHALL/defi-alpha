# ── DeFi Alpha — environment configuration ─────────────────────────────
# Copy to .env and fill in what you use. All values are optional except PORT.

# Server
PORT=5000
NODE_ENV=production
SITE_URL=https://defialpha.example.com

# ── Alpha Brain (AI advisor) ───────────────────────────────────────────
# Without a key, Alpha Brain runs in "local advisor" mode using the live
# DeFiLlama dataset (no external calls). Set a key to unlock LLM mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Twitter bot ────────────────────────────────────────────────────────
# Auto-posting is OFF unless TWITTER_AUTO_POST=true. Manual posting via the
# admin endpoints always works when credentials are present.
TWITTER_AUTO_POST=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── Database (optional) ────────────────────────────────────────────────
# The app is fully functional with in-memory storage. Set DATABASE_URL to
# persist users/conversations/watchlists across restarts (PostgreSQL).
# DATABASE_URL=postgres://user:pass@localhost:5432/defi_alpha
